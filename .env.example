# Pangea MCP - Environment Configuration
#
# Copy this file to .env and fill in the required values.
# Never commit the .env file to version control.

# =============================================================================
# REQUIRED - API Secrets
# =============================================================================

# Datajud API Key
# Public API for Brazilian judicial data (CNJ)
# Get your key from: https://api-publica.datajud.cnj.jus.br/
DATAJUD_API_KEY=your_datajud_api_key_here

# Falcao Token Secret
# Used for authentication hash generation with the labor jurisprudence API
FALCAO_TOKEN_SECRET=your_falcao_token_secret_here

# =============================================================================
# OPTIONAL - Base URL Overrides (defaults are provided)
# =============================================================================

# Datajud API Base URL
# Default: https://api-publica.datajud.cnj.jus.br/
# DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br/

# Falcao API Base URL
# Default: https://jurisprudencia.jt.jus.br/jurisprudencia-nacional-backend/api
# FALCAO_BASE_URL=https://jurisprudencia.jt.jus.br/jurisprudencia-nacional-backend/api

# BNP API Base URL
# Default: https://pangeabnp.pdpj.jus.br/api/v1/
# BNP_BASE_URL=https://pangeabnp.pdpj.jus.br/api/v1/
