{
  "name": "pangea-mcp",
  "version": "1.0.0",
  "author": {
    "name": "Oscar Neto",
    "email": "oscaromsn@gmail.com"
  },
  "main": "src/index.ts",
  "dependencies": {
    "@effect/ai": "^0.31.0",
    "@effect/ai-openai": "^0.34.0",
    "@effect/cli": "^0.71.0",
    "@effect/experimental": "^0.56.0",
    "@effect/opentelemetry": "^0.58.0",
    "@effect/platform": "^0.92.1",
    "@effect/platform-bun": "^0.81.1",
    "@effect/rpc": "^0.71.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "effect": "^3.18.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@effect/language-service": "^0.44.0",
    "@effect/vitest": "^0.19.0",
    "@types/bun": "^1.3.0",
    "typescript": "5.8.3",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "bin": {
    "server": "src/server.ts"
  },
  "description": "TypeScript MCP server for searching Brazilian jurisprudence using the Pangea legal database",
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "mcp",
    "llm",
    "legal",
    "jurisprudence",
    "brazil",
    "pangea",
    "typescript",
    "bun"
  ],
  "license": "MIT",
  "private": true,
  "scripts": {
    "prepare": "effect-language-service patch",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "agent": "bun src/agent/main.ts",
    "agent:dev": "bun --watch src/agent/main.ts",
    "typecheck": "bunx --bun tsc --noEmit --pretty",
    "check": "biome check --write .",
    "test": "bunx vitest",
    "test:coverage": "bunx vitest --coverage"
  },
  "type": "module",
  "types": "types/index.ts"
}
